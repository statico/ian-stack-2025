{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/server/db/types.ts && biome check --write src/server/db/types.ts",
    "db:up": "kysely migrate:up",
    "db:down": "kysely migrate:down",
    "db:latest": "kysely migrate:latest",
    "db:url": "grep DATABASE_URL .env | cut -d= -f2",
    "db:schema": "mkdir -p docs && pg_dump --schema-only --no-tablespaces --no-comments --no-owner --no-privileges --schema public $(pnpm -s db:url) | grep -v '^\\\\restrict' | grep -v '^\\\\unrestrict' | pnpm sql-formatter --language postgresql > docs/schema.sql",
    "test": "TZ=UTC TEST=1 vitest",
    "test:watch": "TZ=UTC TEST=1 vitest --watch",
    "types": "tsc --noEmit --skipLibCheck",
    "types:watch": "tsc --noEmit --watch --skipLibCheck"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "^11.8.1",
    "@trpc/next": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "@trpc/tanstack-react-query": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.28.9",
    "kysely-ctl": "^0.19.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.5",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "use-debounce": "^10.0.6",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@electric-sql/pglite": "^0.3.14",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "kysely-codegen": "^0.19.0",
    "kysely-pglite": "^0.6.1",
    "kysely-pglite-dialect": "^1.2.0",
    "lefthook": "^2.0.13",
    "sql-formatter": "^15.6.12",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp"
    ],
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "msw",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.26.2"
}
