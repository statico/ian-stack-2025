{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "everything": "pnpm lint:fix && pnpm format:fix && pnpm types && pnpm test",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/server/db/types.ts && prettier --write src/server/db/types.ts",
    "db:up": "kysely migrate:up",
    "db:down": "kysely migrate:down",
    "db:latest": "kysely migrate:latest",
    "db:url": "grep DATABASE_URL .env | cut -d= -f2",
    "db:schema": "mkdir -p docs && pg_dump --schema-only --no-tablespaces --no-comments --no-owner --no-privileges --schema public $(pnpm -s db:url) | grep -v '^\\\\restrict' | grep -v '^\\\\unrestrict' | pnpm sql-formatter --language postgresql > docs/schema.sql",
    "test": "TZ=UTC TEST=1 vitest",
    "test:watch": "TZ=UTC TEST=1 vitest --watch",
    "types": "tsc --noEmit --skipLibCheck",
    "types:watch": "tsc --noEmit --watch --skipLibCheck"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.96.2",
    "@trpc/client": "^11.16.0",
    "@trpc/next": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@trpc/tanstack-react-query": "^11.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.28.15",
    "kysely-ctl": "^0.20.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "kysely-codegen": "^0.20.0",
    "kysely-pglite": "^0.6.1",
    "kysely-pglite-dialect": "^1.3.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.8.1",
    "sql-formatter": "^15.7.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp"
    ],
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "msw",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
