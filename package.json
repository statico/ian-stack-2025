{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/server/db/types.ts && prettier --write src/server/db/types.ts",
    "db:up": "kysely migrate:up",
    "db:down": "kysely migrate:down",
    "db:latest": "kysely migrate:latest",
    "db:url": "grep DATABASE_URL .env | cut -d= -f2",
    "db:schema": "mkdir -p docs && pg_dump --schema-only --no-tablespaces --no-comments --no-owner --no-privileges --schema public $(pnpm -s db:url) | grep -v '^\\\\restrict' | grep -v '^\\\\unrestrict' | pnpm sql-formatter --language postgresql > docs/schema.sql",
    "test": "TZ=UTC TEST=1 vitest",
    "test:watch": "TZ=UTC TEST=1 vitest --watch",
    "types": "tsc --noEmit --skipLibCheck",
    "types:watch": "tsc --noEmit --watch --skipLibCheck"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.9",
    "@trpc/client": "^11.7.1",
    "@trpc/next": "^11.7.1",
    "@trpc/server": "^11.7.1",
    "@trpc/tanstack-react-query": "^11.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "kysely": "^0.28.8",
    "kysely-ctl": "^0.19.0",
    "lucide-react": "^0.553.0",
    "next": "16.0.3",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "use-debounce": "^10.0.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "^16.0.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "kysely-codegen": "^0.19.0",
    "kysely-pglite": "^0.6.1",
    "kysely-pglite-dialect": "^1.2.0",
    "lint-staged": "^16.2.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sql-formatter": "^15.6.10",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp"
    ],
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "msw",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.22.0"
}
